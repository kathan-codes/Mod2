{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Root: Electric Field Calculator",
            "command": "D:/msys64/ucrt64/bin/gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-std=c99",
                "${workspaceFolder}/charge_config.c",
                "${workspaceFolder}/electric_field.c",
                "-lm",
                "-o",
                "${workspaceFolder}/electric_field_calculator.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "D:/msys64/ucrt64/bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compile both charge_config.c and electric_field.c together"
        },
        {
            "type": "shell",
            "label": "Build ProjectV1: Electrostatic Simulation Suite",
            "command": "D:/msys64/ucrt64/bin/gcc.exe",
            "args": [
                "-Wall",
                "-Wextra",
                "-O2",
                "-DINTEGRATED_BUILD",
                "${workspaceFolder}/ProjectV1/main.c",
                "${workspaceFolder}/ProjectV1/charge_config.c",
                "${workspaceFolder}/ProjectV1/electric_field.c",
                "${workspaceFolder}/ProjectV1/equipotential.c",
                "${workspaceFolder}/ProjectV1/electric_field_mapper.c",
                "${workspaceFolder}/ProjectV1/results_manager.c",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-lm",
                "-o",
                "${workspaceFolder}/ProjectV1/electric_field_simulator.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/ProjectV1",
                "env": {
                    "PATH": "D:/msys64/ucrt64/bin;${env:PATH}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build",
            "detail": "Compile integrated ProjectV1 with Raylib into electric_field_simulator.exe"
        }
    ]
}